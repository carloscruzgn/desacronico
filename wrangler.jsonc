{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "desacronico",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Cada partida es un Durable Object: guarda el estado y reparte los mensajes por WebSocket.
  "durable_objects": {
    "bindings": [{ "name": "PARTIDA", "class_name": "Partida" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Partida"] }]
}
